/-
  Concrete guarded certificates (2026-09 audit). Generated by
  `lean_tools/gen_guarded_certs.py` from exact integer arithmetic, but every fact
  below is checked by Lean: numerals by kernel evaluation (`decide +kernel`, no
  `native_decide`, so no `Lean.ofReduceBool`), analysis by the general theorems in
  `BBPGuarded.lean`.

  * `bbpGuardAgrees_of_lt_301`: the guard check passes for every `n ≤ 300`.
  * `bbpCertFloor_bracket_series_of_le_300` / `…_pi_…`: for every `n ≤ 300`,
    `bbpCertFloor n ≤ 16^n·bbpSeries < bbpCertFloor n + 1` (series: unconditional;
    π: conditional on `BBPPiEqualsSeries` only).
  * `BBPSpigotDigitCorrect_of_le_300`: P-BBP-01 at every `n ≤ 300`, conditional on H-04.
  * `bbpSeries_bracket_N` (N = 0…46): explicit two-sided brackets
    `S_N ≤ 16^N·bbpSeries < S_N + 1` with `S_N = ⌊16^N·π⌋` written out. These replace the
    former one-sided/trivial `*_upper_holds_*` families.
  * Tier-1 (n = 5, 17, 18, 24, 29, 32, 40, 42): `BBPSpigotDigitCorrect_<n>` and the digit
    value `bbpHexDigitReal_<n>`, conditional on H-04 only (no `hz` hypotheses).
-/
import Thoughts.Proved.BBPGuarded
import Thoughts.Proved.BBPSpigot

namespace FinitistProved

open Real

/-- The guard check passes at every `n ≤ 300` (one kernel evaluation). -/
theorem bbpGuardAgrees_of_lt_301 : ∀ n < 301, bbpGuardAgrees n := by decide +kernel

theorem bbpCertFloor_bracket_series_of_le_300 (n : ℕ) (hn : n ≤ 300) :
    (bbpCertFloor n : ℝ) ≤ (16 : ℝ) ^ n * bbpSeries ∧
      (16 : ℝ) ^ n * bbpSeries < (bbpCertFloor n : ℝ) + 1 :=
  bbpCertFloor_bracket_series n (bbpGuardAgrees_of_lt_301 n (by omega))

theorem bbpCertFloor_eq_floor_series_of_le_300 (n : ℕ) (hn : n ≤ 300) :
    ⌊(16 : ℝ) ^ n * bbpSeries⌋ = (bbpCertFloor n : ℤ) :=
  bbpCertFloor_eq_floor_series n (bbpGuardAgrees_of_lt_301 n (by omega))

theorem bbpCertFloor_bracket_pi_of_le_300 (hπ : BBPPiEqualsSeries) (n : ℕ) (hn : n ≤ 300) :
    (bbpCertFloor n : ℝ) ≤ (16 : ℝ) ^ n * Real.pi ∧
      (16 : ℝ) ^ n * Real.pi < (bbpCertFloor n : ℝ) + 1 :=
  bbpCertFloor_bracket_pi hπ n (bbpGuardAgrees_of_lt_301 n (by omega))

/-- **P-BBP-01 for every `n ≤ 300`**, conditional only on `BBPPiEqualsSeries` (H-04). -/
theorem BBPSpigotDigitCorrect_of_le_300 (hπ : BBPPiEqualsSeries) (n : ℕ) (hn : n ≤ 300) :
    BBPSpigotDigitCorrect n :=
  BBPSpigotDigitCorrect_of_guard hπ n (bbpGuardAgrees_of_lt_301 n (by omega))

